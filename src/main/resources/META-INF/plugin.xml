<idea-plugin>
    <id>io.github.cafecanudo.soundbridgeduplex</id>
    <name>SoundBridge Duplex</name>
    <vendor url="https://github.com/Cafecanudo/soundbridge_plugin_jetbrains_duplex">Wellton S. Barros</vendor>

    <description><![CDATA[
        Send files and folders to another computer over an audio cable, using the SoundBridge
        OFDM transceiver.
        Right-click a file or folder in the Project view and choose <b>SoundBridge &gt; Send</b>, or
        <b>SoundBridge &gt; Verify</b> to check whether the receiver has the same files. In the Commit
        tool window, deleted files are removed on the receiver too.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="soundbridge-vcs.xml">com.intellij.modules.vcs</depends>

    <resource-bundle>messages.SoundBridgeBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                parentId="tools"
                id="io.github.cafecanudo.soundbridgeduplex.settings"
                instance="io.github.cafecanudo.soundbridgeduplex.settings.SoundBridgeConfigurable"
                displayName="SoundBridge"/>
        <notificationGroup id="SoundBridge" displayType="BALLOON"/>
        <toolWindow
                id="SoundBridge"
                anchor="right"
                icon="AllIcons.Actions.Upload"
                factoryClass="io.github.cafecanudo.soundbridgeduplex.send.SoundBridgeToolWindowFactory"/>
        <toolWindow
                id="SoundBridge.Receive"
                anchor="right"
                secondary="true"
                icon="AllIcons.Actions.Download"
                factoryClass="io.github.cafecanudo.soundbridgeduplex.receive.ReceiveToolWindowFactory"/>
        <toolWindow
                id="SoundBridge.History"
                anchor="bottom"
                icon="AllIcons.Vcs.History"
                factoryClass="io.github.cafecanudo.soundbridgeduplex.history.HistoryToolWindowFactory"/>
    </extensions>

    <actions>
        <group id="SoundBridge.ProjectMenu" popup="true" compact="true" icon="AllIcons.Actions.Upload">
            <action
                    id="SoundBridge.Send"
                    class="io.github.cafecanudo.soundbridgeduplex.send.SendAction"
                    icon="AllIcons.Actions.Upload"/>
            <action
                    id="SoundBridge.Verify"
                    class="io.github.cafecanudo.soundbridgeduplex.send.VerifyAction"
                    icon="AllIcons.Actions.Help"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
